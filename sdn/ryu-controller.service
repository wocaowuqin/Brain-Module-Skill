[Unit]
Description=Ryu OpenFlow 1.3 learning-switch and REST controller
After=network-online.target openvswitch-switch.service
Wants=network-online.target
Requires=openvswitch-switch.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ryu-manager-compat --ofp-tcp-listen-port 6653 --wsapi-port 8080 ryu.app.simple_switch_13 ryu.app.ofctl_rest
Restart=on-failure
RestartSec=2
Environment=PYTHONWARNINGS=ignore::DeprecationWarning

[Install]
WantedBy=multi-user.target
